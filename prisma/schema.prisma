generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(ADMIN)
  avatar    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  news      News[]
  galleries Gallery[]

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

// ==========================================
// NEWS / ARTICLE MODEL
// ==========================================
model News {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  excerpt     String?      @db.Text
  content     String       @db.Text
  coverImage  String?
  category    NewsCategory
  isPublished Boolean      @default(false)
  publishedAt DateTime?
  views       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Comments relation
  comments Comment[]

  @@index([slug])
  @@index([category])
  @@index([isPublished])
  @@index([publishedAt])
  @@map("news")
}

enum NewsCategory {
  ARTIKEL
  BERITA
  KEGIATAN
  PENGUMUMAN
}

// ==========================================
// COMMENT MODEL (for News)
// ==========================================
model Comment {
  id          String   @id @default(cuid())
  content     String   @db.Text
  authorName  String
  authorEmail String?
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  newsId String
  news   News   @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@index([newsId])
  @@map("comments")
}

// ==========================================
// ALBUM MODEL (Gallery Categories)
// ==========================================
model Album {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  coverImage  String?
  sortOrder   Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  galleries Gallery[]

  @@index([slug])
  @@index([sortOrder])
  @@map("albums")
}

// ==========================================
// GALLERY / PHOTO MODEL
// ==========================================
model Gallery {
  id           String    @id @default(cuid())
  title        String
  description  String?   @db.Text
  imageUrl     String
  thumbnailUrl String?
  eventDate    DateTime?
  isPublished  Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  albumId      String?
  album        Album?  @relation(fields: [albumId], references: [id], onDelete: SetNull)
  uploadedById String
  uploadedBy   User    @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([albumId])
  @@index([isPublished])
  @@index([eventDate])
  @@map("galleries")
}

// ==========================================
// CLIENT CATEGORY MODEL
// ==========================================
model ClientCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  clients Client[]

  @@index([sortOrder])
  @@index([isActive])
  @@map("client_categories")
}

// ==========================================
// CLIENT MODEL
// ==========================================
model Client {
  id          String   @id @default(cuid())
  name        String
  logo        String
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  categoryId String
  category   ClientCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([isPublished])
  @@index([sortOrder])
  @@map("clients")
}

// ==========================================
// MANAGEMENT TEAM MODEL
// ==========================================
model ManagementTeam {
  id          String   @id @default(cuid())
  name        String
  title       String
  image       String?
  description String   @db.Text
  isMappiCert Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@map("management_teams")
}

// ==========================================
// HERO IMAGE MODEL
// ==========================================
model HeroImage {
  id        String   @id @default(cuid())
  imageUrl  String
  altText   String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@index([isActive])
  @@map("hero_images")
}

// ==========================================
// CLIENT CONTACT MODEL (for Client Management)
// ==========================================
model ClientContact {
  id               String            @id @default(cuid())
  name             String
  type             ClientType
  address          String            @db.Text
  picName          String
  phone            String
  email            String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  trackingProjects TrackingProject[]

  @@index([type])
  @@index([createdAt])
  @@map("client_contacts")
}

enum ClientType {
  CORPORATE
  PERORANGAN
  SME
  INSTANSI
}

// ==========================================
// TRACKING PROJECT MODEL
// ==========================================
model TrackingProject {
  id           String @id @default(cuid())
  projectId    String @unique // e.g., PRJ-2024-001
  proposalNo   String // e.g., PROP/AKR/2024/I/001
  trackingCode String @unique // e.g., AKR-A1B2C3 - untuk tracking publik

  // Client relation
  clientId String
  client   ClientContact @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Object details
  objectType PropertyObjectType
  objective  String // Tujuan penilaian
  address    String             @db.Text

  // Progress tracking
  status   ProjectStatus @default(VERIFIKASI_DOKUMEN)
  progress Int           @default(0) // 0-100

  // Discussion
  initialMessage String? @db.Text

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  // Relations
  projectProgresses ProjectProgress[]

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
  @@index([trackingCode])
  @@map("tracking_projects")
}

enum ProjectStatus {
  VERIFIKASI_DOKUMEN
  INSPEKSI_LAPANGAN
  PROSES_REVIEW
  LAPORAN_FINAL
  SELESAI
}

enum PropertyObjectType {
  RUMAH_TINGGAL
  RUKO_KANTOR
  TANAH_KOSONG
  GUDANG
  APARTEMEN
  PABRIK
  LAINNYA
}

// ==========================================
// PROJECT PROGRESS MODEL (for detailed tracking)
// ==========================================
model ProjectProgress {
  id        String @id @default(cuid())
  projectId String

  // Stage info
  stageId     Int // 1-5 main stages
  stageName   String
  subStepId   String // e.g., "1a", "1b", "2a"
  subStepName String

  // Status tracking
  status    ProgressStatus @default(PENDING)
  startDate DateTime?
  endDate   DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation
  project TrackingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, subStepId])
  @@index([projectId])
  @@index([status])
  @@map("project_progress")
}

enum ProgressStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}
